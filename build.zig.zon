.{
    .name = .docgen,
    .version = "0.0.0",
    .fingerprint = 0xef4e5a86553a73be, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The CLI parser and the executable's buffered stdio.
        .cli = .{
            .url = "https://baskingspot.dev/cli/v0.1.0.tar.gz",
            .hash = "cli-0.1.0-nGM5m0b4AAAQ6VJl6BzyRwsYXIzXPOw7Q14HdW6Tah0o",
        },
        .stdx = .{
            .url = "https://baskingspot.dev/stdx/v0.2.0.tar.gz",
            .hash = "stdx-0.2.0-CcWeggcIDwBIs7R6BX4h5bDz5Cd-SrTSTIBms3j-71oA",
        },
        // The test runner. Lazy: only the root build runs tests, and
        // build.zig returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.4.0.tar.gz",
            .hash = "testingx-0.4.0-ib95-2JkAwDVM639ma-akYafT4bdewLfpFaAEnLBzQXG",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
    },
}
