.{
    .name = .docgen,
    .version = "0.0.0",
    .fingerprint = 0xef4e5a86553a73be, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The CLI parser and the executable's buffered stdio.
        .cli = .{
            .url = "https://baskingspot.dev/cli/v0.3.1.tar.gz",
            .hash = "cli-0.3.1-nGM5m-sVAQB7tupXqokmZpPHajiV5eZPcbUVDRvGgNPb",
        },
        .stdx = .{
            .url = "https://baskingspot.dev/stdx/v0.3.0.tar.gz",
            .hash = "stdx-0.3.0-CcWego4nDwC5PxPd4F-nlcOWXxAVCZ6MDI5f3YNVNSO7",
        },
        // The test runner. Lazy: only the root build runs tests, and
        // build.zig returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.4.0.tar.gz",
            .hash = "testingx-0.4.0-ib95-2JkAwDVM639ma-akYafT4bdewLfpFaAEnLBzQXG",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
    },
}
