.{
    .name = .docgen,
    .version = "0.0.0",
    .fingerprint = 0xef4e5a86553a73be, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The CLI parser and the executable's buffered stdio.
        .cli = .{
            .url = "https://baskingspot.dev/cli/v0.1.0.tar.gz",
            .hash = "cli-0.1.0-nGM5m0b4AAAQ6VJl6BzyRwsYXIzXPOw7Q14HdW6Tah0o",
            .lazy = true,
        },
        .stdx = .{
            .url = "git+https://github.com/baskingspot/stdx#c6f2e7900e14f979c361c18918d2122d7a373a5c",
            .hash = "stdx-0.0.0-CcWegm0xCgCN4VjaT2zvjvJ1L4zHgQFl4Xi7rhjQNfxj",
            .lazy = true,
        },
        // The test runner. Lazy: only the root build runs tests, and
        // build.zig returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.1.1.tar.gz",
            .hash = "testingx-0.1.1-ib95-6ivAgB3rCWLHww0C7edG1NLC71y1p1wogPV0Djf",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
    },
}
